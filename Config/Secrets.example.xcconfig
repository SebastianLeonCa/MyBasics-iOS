// Copia este archivo como Config/Secrets.xcconfig (ignorado por Git) y completa tus valores.
// Nota: en .xcconfig "//" inicia un comentario, por eso la URL se escribe como https:/$()/...
// Si dejas los placeholders de Supabase, la app usa los datos de ejemplo (mock).

// Supabase › Project Settings › API (o el botón "Connect")
SUPABASE_URL = https:/$()/TU-PROYECTO.supabase.co
// "Publishable key" (sb_publishable_...) o la "anon" key (legacy). NUNCA la secret/service_role.
SUPABASE_ANON_KEY = TU_ANON_KEY

// Fase 4 · Google: OAuth client ID de tipo "iOS" (Google Cloud Console › Credentials).
// Se ve como 1234567890-abc123.apps.googleusercontent.com. Vacío = se oculta "Continuar con Google".
GOOGLE_IOS_CLIENT_ID =
